{
  "imports": {
    // Server-renders the screens in tests: the version @preact/preset-vite already locks.
    "preact-render-to-string": "npm:preact-render-to-string@6.7.0",
    // A browser DOM for the interaction tests: focus, form submission and FormData.
    "happy-dom": "npm:happy-dom@20.14.5"
  },
  // `ui-text/no-literal` (#216) flags English text written in a component's markup: its text and
  // its DOM attributes. Every screen keeps to it; only a test file may opt out with
  // `// deno-lint-ignore-file ui-text/no-literal`.
  // The rule does not see English kept in constants or passed to a component's own props: the
  // en-XA tests catch those (#275).
  "lint": {
    "plugins": ["jsr:@spy4x/preact-theme@11.1.0/lint"]
  }
}
