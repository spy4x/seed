PROJECT=app
ENV=dev # or "prod"
CONTAINER_PROVIDER=docker # or "podman"
DOMAIN=app.localhost
DEV_EMAIL=dev@example.com
DENO_LOG=debug
COMPOSE_BAKE=true
# Uncomment to also run promtail, node-exporter and cAdvisor, which watch the whole host. Leave
# off on a server whose host already has its own monitoring.
# COMPOSE_PROFILES=host-monitoring
# Also serve the public website (apps/mpa) at MPA_DOMAIN; join profiles with commas:
# COMPOSE_PROFILES=mpa
# With the mpa profile: the website's own host, next to the SPA at DOMAIN (same server, same API).
# The MPA refuses to start without it.
MPA_DOMAIN=

DB_CPU_LIMIT=2
DB_MEM_LIMIT=2048m
DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASS=app

PROXY_CPU_LIMIT=1
PROXY_MEM_LIMIT=512m
# Traefik's log level. `debug` logs every request: use it on your own machine only.
PROXY_LOG_LEVEL=info
# Production certificates (Let's Encrypt, HTTP challenge). TRAEFIK_ACME_EMAIL is where expiry
# notices go. TRAEFIK_CERT_RESOLVER is the resolver name the production routers use: keep the
# default when compose.proxy.yml runs Traefik, or set the name your shared Traefik already defines.
# Set a real address before deploying: Let's Encrypt refuses example.com, and an empty value
# means no expiry notices.
TRAEFIK_ACME_EMAIL=
TRAEFIK_CERT_RESOLVER=myresolver

KV_CPU_LIMIT=1
KV_MEM_LIMIT=512m
KV_MEM_INNER_LIMIT=400mb
KV_HOSTNAME=kv
KV_PORT=6379
# Valkey refuses to start without it and the API refuses to start without it. Generate one with
# `openssl rand -hex 24`.
KV_PASSWORD=change-me
# Host address and port Valkey is published on. Keep 127.0.0.1: anyone who can reach Valkey can
# write to the cache. Postgres is the same through DB_HOST_PORT (default 127.0.0.1:$DB_PORT).
KV_HOST_PORT=127.0.0.1:6380

MINIO_CPU_LIMIT=1
MINIO_MEM_LIMIT=512m
MINIO_USER=admin
MINIO_PASS=change-me

LOKI_CPU_LIMIT=1
LOKI_MEM_LIMIT=1024m

PROMTAIL_CPU_LIMIT=1
PROMTAIL_MEM_LIMIT=512m

PROMETHEUS_CPU_LIMIT=1
PROMETHEUS_MEM_LIMIT=1024m

POSTGRES_EXPORTER_CPU_LIMIT=1
POSTGRES_EXPORTER_MEM_LIMIT=512m

GRAFANA_PASS=change-me
GRAFANA_CPU_LIMIT=1
GRAFANA_MEM_LIMIT=512m

NODEEXPORTER_CPU_LIMIT=1
NODEEXPORTER_MEM_LIMIT=512m

CADVISOR_CPU_LIMIT=1
CADVISOR_MEM_LIMIT=512m

DENO_VERSION=2.9.7
API_CPU_LIMIT=1
API_MEM_LIMIT=512M
API_PORT=8000
WORKER_CPU_LIMIT=0.5
WORKER_MEM_LIMIT=256M
MIGRATE_CPU_LIMIT=0.5
MIGRATE_MEM_LIMIT=256M
# At least 32 characters each, or the API refuses to start: openssl rand -hex 32
AUTH_COOKIE_SECRET=REPLACE_WITH_RANDOM_STRING_OF_32_OR_MORE_CHARS
AUTH_PEPPER=REPLACE_WITH_RANDOM_STRING_OF_32_OR_MORE_CHARS
SEED_PASSWORD=change-me-demo-password # the demo user's password for db:seed and db:reset, 8 to 50 characters
AUTH_TOTP=REPLACE_WITH_RANDOM_STRING
TIMEZONE=Asia/Singapore
RATE_LIMITER_WINDOW_MS=60000
RATE_LIMITER_STRICT_LIMIT=30
RATE_LIMITER_LIMIT=100
# One-time-code checks per user: 5 per 15 minutes, since a six-digit code is a small secret
RATE_LIMITER_OTP_WINDOW_MS=900000
RATE_LIMITER_OTP_LIMIT=5
# Mail for password reset links, sent by the worker. With ENV=dev mail goes to the worker's log and
# the dev_mail table, and these are ignored. In production all five must be set, or nothing is sent:
# the API and the worker still start, log one warning naming the missing keys, and every other
# feature works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="App <noreply@example.com>"
# Billing (docs/billing.md). Unset BILLING_PROVIDER means off in production and the development
# provider with ENV=dev. With BILLING_PROVIDER=stripe all three Stripe keys must be set, or the API
# refuses to start. Use test-mode keys (sk_test_..., whsec_... from `stripe listen`) outside production.
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# Days a group whose payment failed keeps its plan (whole number, 0 to 90). Unset or empty means 7.
BILLING_GRACE_DAYS=
# Whether starting a trial asks for a card: true or false. Unset or empty means true. With false, a
# trial that ends without a card cancels the subscription and the group goes back to Free.
BILLING_TRIAL_REQUIRES_CARD=
# Mail subscriptions (README, "Mail subscriptions"). Signs every confirm and unsubscribe link, so it
# must not be the cookie secret. At least 32 printable characters: openssl rand -base64 48. Unset in
# production turns subscriptions off; with ENV=dev, unset signs with a public development value.
SUBSCRIBERS_SECRET=
# After a rotation, the earlier SUBSCRIBERS_SECRET values, comma-separated: they only check old links.
SUBSCRIBERS_PREVIOUS_SECRETS=

# Error tracker (docs/stack.md, "Error tracking"): a GlitchTip or Sentry DSN, https://<key>@<host>/<project>.
# Empty means no reporting and no request. The API reports unhandled exceptions with the request id.
ERROR_REPORT_DSN=
# The same for the browser (a project of its own is best). Public by design: the SPA container
# writes it into /config.json when it starts, so changing it needs a restart, not a rebuild.
SPA_ERROR_REPORT_DSN=
# Optional modules of the SPA (docs/offline.md, "Switching a module off"). Empty means on. `false`
# turns the WebSocket module off (the page then reads and writes over HTTP and checks for changes
# every 30 seconds) or the offline layer off (no device copy, no queue of writes).
SPA_REALTIME=
SPA_OFFLINE=

# The dev SPA container runs Vite. Held to 1 CPU and 512M it restarted in a loop (esbuild, which Vite
# starts, ended with "all goroutines are asleep - deadlock!"); at 2 CPUs and 2G it still restarted
# once in the first minute. 4 CPUs and 4G stayed up for 11 minutes from a fresh stack. These are
# limits, not use: the container idles far below them. Production serves static files and needs
# much less.
SPA_CPU_LIMIT=4
SPA_MEM_LIMIT=4G

S3_BUCKET_BACKUPS_NAME=app-backups
S3_BUCKET_BACKUPS_DB_FOLDER=db
S3_BUCKET_BACKUPS_ACCESS_KEY_ID=
S3_BUCKET_BACKUPS_SECRET_ACCESS_KEY=
S3_BUCKET_BACKUPS_REGION=ap-southeast-1
S3_BUCKET_BACKUPS_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com

# Ports published on this machine, as `127.0.0.1:<port>`: Postgres here, Valkey in KV_HOST_PORT
# above, the MinIO console and Grafana (README, "Admin consoles"). Two projects on one machine
# cannot hold the same port: give every project after the first its own four, and its own PROJECT
# and DOMAIN (README, "Several projects on one server"). Never publish any of them on 0.0.0.0.
DB_HOST_PORT=127.0.0.1:5432
MINIO_CONSOLE_HOST_PORT=127.0.0.1:9001
GRAFANA_HOST_PORT=127.0.0.1:3000

# `deno task deploy` only (infra/scripts/deploy.ts); it stops when one of the first two is empty.
# SSH_TO_SERVER is the SSH destination: user@host, or a Host alias from ~/.ssh/config.
# PATH_ON_SERVER is the app's directory on the server, absolute or relative to the SSH user's home.
# DENO_ON_SERVER is the command that runs Deno there; ~/.deno/bin is searched first.
SSH_TO_SERVER=
PATH_ON_SERVER=
DENO_ON_SERVER=deno
