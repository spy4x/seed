PROJECT=app
ENV=dev # or "prod"
CONTAINER_PROVIDER=docker # or "podman"
DOMAIN=app.localhost
DEV_EMAIL=dev@example.com
DENO_LOG=debug
COMPOSE_BAKE=true
# Which optional parts Compose starts; join several with commas (COMPOSE_PROFILES=monitoring,mpa).
# - monitoring: this project's own VictoriaMetrics, VictoriaLogs, Grafana, vmalert and Alertmanager
#   (the bundled mode). Remove it to send metrics and logs to another server instead: see
#   VM_REMOTE_WRITE_URL and VLOGS_URL below.
# - host-monitoring: node-exporter and cAdvisor, which watch the whole host. Leave off on a server
#   whose host already has its own monitoring.
# - mpa: the public website (apps/mpa) at MPA_DOMAIN.
# - admin: the operator area (apps/admin) at ADMIN_DOMAIN.
# - backup: a daily backup of the database; needs the BACKUP_* variables below (README, "Backups").
COMPOSE_PROFILES=monitoring
# With the mpa profile: the website's own host, next to the SPA at DOMAIN (same server, same API).
# The MPA refuses to start without it.
MPA_DOMAIN=
# Production only, optional: a Traefik rule for hosts that answer a permanent redirect to the same
# path on MPA_DOMAIN, such as the www host. Join hosts with ||:
# MPA_REDIRECT_RULE=Host(`www.example.com`) || Host(`old.example.com`). Each host needs a DNS
# record pointing at the server; Traefik gets its certificate. Empty matches nothing.
MPA_REDIRECT_RULE=
# With the admin profile: the admin app's own host, such as admin.example.com. The API answers the
# operator area (/api/admin) on this host only, and only sign-in there. Empty: no operator area.
ADMIN_DOMAIN=admin.localhost

DB_CPU_LIMIT=2
DB_MEM_LIMIT=2048m
# Postgres memory settings. The defaults fit DB_MEM_LIMIT=2048m (512MB + 30 connections x 16MB +
# 128MB + 3 autovacuum workers x 128MB = 1504MB). With a larger limit, raise them here too: about
# a quarter of the limit for shared buffers and three quarters for the cache size.
# DB_SHARED_BUFFERS=512MB
# DB_WORK_MEM=16MB
# DB_MAINTENANCE_WORK_MEM=128MB
# DB_EFFECTIVE_CACHE_SIZE=1536MB
# DB_AUTOVACUUM_WORK_MEM=128MB
DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASS=app

PROXY_CPU_LIMIT=1
PROXY_MEM_LIMIT=512m
# Traefik's log level. `debug` logs every request: use it on your own machine only.
PROXY_LOG_LEVEL=info
# Production certificates (Let's Encrypt, HTTP challenge). TRAEFIK_ACME_EMAIL is where expiry
# notices go. TRAEFIK_CERT_RESOLVER is the resolver name the production routers use: keep the
# default when compose.proxy.yml runs Traefik, or set the name your shared Traefik already defines.
# Set a real address before deploying: Let's Encrypt refuses example.com, and an empty value
# means no expiry notices.
TRAEFIK_ACME_EMAIL=
TRAEFIK_CERT_RESOLVER=myresolver

KV_CPU_LIMIT=1
KV_MEM_LIMIT=512m
KV_MEM_INNER_LIMIT=400mb
KV_HOSTNAME=kv
KV_PORT=6379
# Valkey refuses to start without it and the API refuses to start without it. Generate one with
# `openssl rand -hex 24`.
KV_PASSWORD=change-me
# Host address and port Valkey is published on. Keep 127.0.0.1: anyone who can reach Valkey can
# write to the cache. Postgres is the same through DB_HOST_PORT (default 127.0.0.1:$DB_PORT).
KV_HOST_PORT=127.0.0.1:6380

# Monitoring (docs/stack.md, "Monitoring"). vmagent and Vector always run and send this project's
# metrics and logs somewhere. Bundled mode: keep `monitoring` in COMPOSE_PROFILES and leave the six
# values below empty; they then send to the VictoriaMetrics and VictoriaLogs containers of this
# project. External mode: take `monitoring` out of COMPOSE_PROFILES and name the other server here.
# VM_REMOTE_WRITE_URL is the full remote-write address, such as
# https://metrics.example.com/api/v1/write. VLOGS_URL is the VictoriaLogs base address, such as
# https://logs.example.com. The user names and passwords are for HTTP basic auth; leave them empty
# for a server that asks for none.
VM_REMOTE_WRITE_URL=
VM_REMOTE_WRITE_USERNAME=
VM_REMOTE_WRITE_PASSWORD=
VLOGS_URL=
VLOGS_USERNAME=
VLOGS_PASSWORD=
# Bundled mode only: where vmalert's alerts go (infra/configs/alerts.yml). ALERT_NTFY_URL is the
# ntfy server, such as https://ntfy.example.com; empty means alerts are sent nowhere.
# ALERT_NTFY_TOKEN is an ntfy access token; empty for a topic anyone may post to.
ALERT_NTFY_URL=
ALERT_NTFY_TOPIC=alerts
ALERT_NTFY_TOKEN=
# Limits of the monitoring containers. All optional: these are the defaults.
VMAGENT_CPU_LIMIT=0.2
VMAGENT_MEM_LIMIT=128M
VECTOR_CPU_LIMIT=0.2
VECTOR_MEM_LIMIT=128M
VICTORIAMETRICS_CPU_LIMIT=0.5
VICTORIAMETRICS_MEM_LIMIT=256M
VICTORIALOGS_CPU_LIMIT=0.5
VICTORIALOGS_MEM_LIMIT=256M
VMALERT_CPU_LIMIT=0.2
VMALERT_MEM_LIMIT=128M
ALERTMANAGER_CPU_LIMIT=0.1
ALERTMANAGER_MEM_LIMIT=64M

POSTGRES_EXPORTER_CPU_LIMIT=1
POSTGRES_EXPORTER_MEM_LIMIT=512m

GRAFANA_PASS=change-me
GRAFANA_CPU_LIMIT=1
GRAFANA_MEM_LIMIT=512m

NODEEXPORTER_CPU_LIMIT=1
NODEEXPORTER_MEM_LIMIT=512m

CADVISOR_CPU_LIMIT=1
CADVISOR_MEM_LIMIT=512m

DENO_VERSION=2.9.7
API_CPU_LIMIT=1
API_MEM_LIMIT=512M
API_PORT=8000
WORKER_CPU_LIMIT=0.5
WORKER_MEM_LIMIT=256M
MIGRATE_CPU_LIMIT=0.5
MIGRATE_MEM_LIMIT=256M
# At least 32 characters each, or the API refuses to start: openssl rand -hex 32
AUTH_COOKIE_SECRET=REPLACE_WITH_RANDOM_STRING_OF_32_OR_MORE_CHARS
AUTH_PEPPER=REPLACE_WITH_RANDOM_STRING_OF_32_OR_MORE_CHARS
SEED_PASSWORD=change-me-demo-password # the demo user's password for db:seed and db:reset, 8 to 50 characters
TIMEZONE=Asia/Singapore
RATE_LIMITER_WINDOW_MS=60000
RATE_LIMITER_STRICT_LIMIT=30
RATE_LIMITER_LIMIT=100
# One-time-code checks per user: 5 per 15 minutes, since a six-digit code is a small secret
RATE_LIMITER_OTP_WINDOW_MS=900000
RATE_LIMITER_OTP_LIMIT=5
# Mail for password reset links, sent by the worker. With ENV=dev mail goes to the worker's log and
# the dev_mail table, and these are ignored. In production all five must be set, or nothing is sent:
# the API and the worker still start, log one warning naming the missing keys, and every other
# feature works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="App <noreply@example.com>"
# Billing (docs/billing.md). Unset BILLING_PROVIDER means off in production and the development
# provider with ENV=dev. With BILLING_PROVIDER=stripe all three Stripe keys must be set, or the API
# refuses to start. Use test-mode keys (sk_test_..., whsec_... from `stripe listen`) outside production.
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# Days a group whose payment failed keeps its plan (whole number, 0 to 90). Unset or empty means 7.
BILLING_GRACE_DAYS=
# Whether starting a trial asks for a card: true or false. Unset or empty means true. With false, a
# trial that ends without a card cancels the subscription and the group goes back to Free.
BILLING_TRIAL_REQUIRES_CARD=
# Mail subscriptions (README, "Mail subscriptions"). Signs every confirm and unsubscribe link, so it
# must not be the cookie secret. At least 32 printable characters: openssl rand -base64 48. Unset in
# production turns subscriptions off; with ENV=dev, unset signs with a public development value.
SUBSCRIBERS_SECRET=
# After a rotation, the earlier SUBSCRIBERS_SECRET values, comma-separated: they only check old links.
SUBSCRIBERS_PREVIOUS_SECRETS=

# Sign in with Google and GitHub (README, "Sign in with Google and GitHub"). A provider is on only
# when both of its values are set; empty means its button is not shown and its routes answer 404.
# The callback to register is https://<DOMAIN>/api/auth/google/callback (or /github/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Error tracker (docs/stack.md, "Error tracking"): a GlitchTip or Sentry DSN, https://<key>@<host>/<project>.
# Empty means no reporting and no request. The API reports unhandled exceptions with the request id.
ERROR_REPORT_DSN=
# The same for the browser (a project of its own is best). Public by design: the SPA container
# writes it into /config.json when it starts, so changing it needs a restart, not a rebuild.
SPA_ERROR_REPORT_DSN=
# Optional modules of the SPA (docs/offline.md, "Switching a module off"). Empty means on. `false`
# or `0` turns the WebSocket module off (the page then reads and writes over HTTP and checks for
# changes every 30 seconds) or the offline layer off (no device copy, no queue of writes).
SPA_REALTIME=
SPA_OFFLINE=

# The dev SPA container runs Vite. Held to 1 CPU and 512M it restarted in a loop (esbuild, which Vite
# starts, ended with "all goroutines are asleep - deadlock!"); at 2 CPUs and 2G it still restarted
# once in the first minute. 4 CPUs and 4G stayed up for 11 minutes from a fresh stack. These are
# limits, not use: the container idles far below them. Production serves static files and needs
# much less.
SPA_CPU_LIMIT=4
SPA_MEM_LIMIT=4G

# Backups, with `backup` in COMPOSE_PROFILES (README, "Backups"). The repository is a restic
# address, such as s3:https://s3.example.com/app-backups; one repository per project. Without the
# password nothing in the repository can be read, so keep a copy of it away from the server. The
# two keys are for an S3 repository.
BACKUP_RESTIC_REPOSITORY=
BACKUP_RESTIC_PASSWORD=
S3_BUCKET_BACKUPS_ACCESS_KEY_ID=
S3_BUCKET_BACKUPS_SECRET_ACCESS_KEY=

# Ports published on this machine, as `127.0.0.1:<port>`: Postgres here, Valkey in KV_HOST_PORT
# above, and Grafana (README, "Admin consoles"). Two projects on one machine cannot hold the same
# port: give every project after the first its own three, and its own PROJECT and DOMAIN (README,
# "Several projects on one server"). Never publish any of them on 0.0.0.0.
DB_HOST_PORT=127.0.0.1:5432
GRAFANA_HOST_PORT=127.0.0.1:3000

# `deno task deploy` only (infra/scripts/deploy.ts); it stops when one of the first two is empty.
# SSH_TO_SERVER is the SSH destination: user@host, or a Host alias from ~/.ssh/config.
# PATH_ON_SERVER is the app's directory on the server, absolute or relative to the SSH user's home.
# DENO_ON_SERVER is the command that runs Deno there; ~/.deno/bin is searched first.
SSH_TO_SERVER=
PATH_ON_SERVER=
DENO_ON_SERVER=deno
