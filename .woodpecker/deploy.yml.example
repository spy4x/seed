# Deploys `main` to the server after every push that passes `ci.yml`.
#
# Woodpecker reads only `*.yml` and `*.yaml` in this folder, so this file does nothing until a
# product copies it to `.woodpecker/deploy.yml`. docs/woodpecker-ci-setup.md, "Deploy on every
# push to main", lists the four repository secrets it needs. Seed itself keeps it off.
#
# The step runs `deno task deploy`, as a developer would: it decrypts the env files with the
# repository's age key, copies the files to the server over SSH and starts them there, where the
# images are built. It holds the age key and an SSH key that can run Docker on the server, which
# is as good as root there, so the secrets are enabled for the push event only: a pull request,
# from a fork or not, never sees them. Only people who may push to the repository can reach them,
# and only reviewed code on `main` runs the deploy. The repository stays untrusted: no volume, no
# Docker socket, no privileged step.
#
# Every runtime variable is written `$$`, so Woodpecker leaves it for the shell. The image is
# pinned by digest.

depends_on: [ci]

when:
  - event: push
    branch: main

steps:
  deploy:
    image: denoland/deno:2.9.7@sha256:fa335acdf6b72106eda2cb6a8cb5f4187e7630e357467489db4b2e7352d5e432
    environment:
      DEPLOY_ENV_KEY:
        from_secret: deploy_env_key
      DEPLOY_SSH_KEY:
        from_secret: deploy_ssh_key
      DEPLOY_SSH_CONFIG:
        from_secret: deploy_ssh_config
      DEPLOY_KNOWN_HOSTS:
        from_secret: deploy_known_hosts
    commands:
      - apt-get update -qq && apt-get install -y -qq --no-install-recommends rsync openssh-client git
      - umask 077
      - mkdir -p ~/.ssh .age
      - printf '%s\n' "$${DEPLOY_SSH_KEY}" > ~/.ssh/deploy_key
      - printf '%s\nIdentityFile ~/.ssh/deploy_key\nIdentitiesOnly yes\n' "$${DEPLOY_SSH_CONFIG}" > ~/.ssh/config
      - printf '%s\n' "$${DEPLOY_KNOWN_HOSTS}" > ~/.ssh/known_hosts
      - printf '%s\n' "$${DEPLOY_ENV_KEY}" > .age/key.txt
      - deno install --frozen
      - deno task env:decrypt
      - deno task deploy
