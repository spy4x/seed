{
  "workspace": [
    "./apps/api",
    "./apps/spa",
    "./apps/admin",
    "./apps/mpa",
    "./apps/worker",
    "./libs/platform",
    "./libs/domain/api-tokens",
    "./libs/domain/billing",
    "./libs/domain/groups",
    "./libs/domain/identity",
    "./libs/domain/blog",
    "./libs/domain/contact-links",
    "./libs/domain/catalog",
    "./libs/domain/notes",
    "./libs/domain/tags",
    "./libs/domain/notifications",
    "./libs/domain/subscribers",
    "./libs/domain/errors",
    "./libs/server/api-tokens",
    "./libs/server/auth",
    "./libs/server/billing",
    "./libs/server/files",
    "./libs/server/groups",
    "./libs/server/jobs",
    "./libs/server/mail",
    "./libs/server/blog",
    "./libs/server/contact-links",
    "./libs/server/catalog",
    "./libs/server/notes",
    "./libs/server/tags",
    "./libs/server/notifications",
    "./libs/server/subscribers",
    "./libs/server/telegram",
    "./libs/ui"
  ],
  "nodeModulesDir": "auto",
  "allowScripts": ["npm:@tailwindcss/oxide@4.1.12"],
  "minimumDependencyAge": { "age": "1440", "exclude": ["jsr:@spy4x/*", "npm:@jsr/spy4x__*"] },
  "tasks": {
    "init": "deno run -R=. -W=infra/envs/.env,infra/envs/.env.tmp,infra/configs/vapid.json,infra/configs/vapid.json.tmp ./infra/scripts/init.ts", // once after cloning: the env file with generated secrets, and the web push keys; see the script
    "dev": "deno run -R=./infra --allow-run=docker,podman ./infra/scripts/proxy-network.ts --start && deno run compose up -d", // starts Traefik unless one runs, then the development environment
    "build": "deno task spa:build", // builds the SPA for production (CI's `build` step)

    // #region apps/api
    "api:dev": "deno serve --allow-all --watch apps/api/index.ts", // used in docker-compose to start the API server in development mode
    "api:prod": "deno serve --allow-all apps/api/index.ts", // production mode - no watch
    // #endregion apps/api

    // #region apps/spa
    "spa:dev": "deno task --cwd apps/spa dev", // used in docker-compose to start the SPA in development mode
    "spa:build": "deno task --cwd apps/spa build",
    // #endregion apps/spa

    // #region apps/admin
    "admin:dev": "deno task --cwd apps/admin dev", // used in docker-compose to start the admin app in development mode
    "admin:build": "deno task --cwd apps/admin build",
    // #endregion apps/admin

    // #region apps/mpa
    "mpa:dev": "deno task --cwd apps/mpa dev",
    "mpa:build": "deno task --cwd apps/mpa build",
    "mpa:start": "deno task --cwd apps/mpa start",
    "mpa:check": "deno task --cwd apps/mpa check",
    "lighthouse": "apps/mpa/lighthouse/run.sh", // the public website's Lighthouse budget, on a built MPA; see the script
    // #endregion apps/mpa

    // #region Scripts
    "db:migrate": "deno run -N=$DB_HOST:$DB_PORT -E -R=./libs/server/db/migrations ./infra/scripts/db-migrate.ts",
    "db:reset": "deno run -N -E -R=./infra/envs --allow-run=deno ./infra/scripts/db-reset.ts", // drop, migrate, seed; dev only, see the script
    "db:seed": "deno run -N=$DB_HOST:$DB_PORT -E ./infra/scripts/seed-data.ts", // the fake population, and the dev administrator; see the script
    "subscribers:send": "deno run -N -E -R ./apps/worker/subscribers-send.ts", // queues an issue for a mailing list; run in the worker container, see docs/development.md
    "user:role": "deno run -N -E -R ./apps/worker/user-role.ts", // gives a person a role by their address, such as operator for the admin app; see docs/apps.md
    "operator:create": "deno run -N -E -R ./apps/worker/operator-create.ts", // creates an administrator with a password typed at a prompt, or makes an existing person one; see docs/deploy.md
    "i18n:stamp": "deno run -R=i18n -W=i18n i18n/stamp.ts", // records which English each translation was made from, once it is translated; see i18n/TRANSLATING.md
    "deps:check": "deno outdated -r",
    "deps:update": "deno outdated -r -u -i",
    "update:ubuntu": "sudo apt update && sudo apt full-upgrade -y && sudo apt autoremove -y && sudo apt clean && sudo apt --fix-broken install && sudo do-release-upgrade",
    "vapid-key:create": "deno run -W=infra/configs/vapid.json ./infra/scripts/vapid-keys-create.ts",
    "load": "deno run -R=./infra/envs --allow-run=docker,podman ./tests/load/run.ts", // k6 load scenarios against the local dev stack, and the Postgres numbers; see docs/capacity.md
    "video:admin": "deno run -A docs/screenshots/admin-video.ts", // records the website's admin panel video from a local stack, see the script
    "demo-video": "deno run -A media/demo/recipe/record.ts", // records the README's demo video into media/demo (--encode re-encodes the last take), see media/demo/recipe/README.md
    "compose": "deno run -R=./infra,./.volumes --allow-run=docker,podman --allow-net=127.0.0.1,0.0.0.0 ./infra/scripts/compose.ts", // reads .volumes to refuse starting Postgres 18 beside unmoved Postgres 16 data; binds the host ports the project publishes, for a moment, to refuse a start when one is taken
    "db:upgrade-18": "deno run -R=./infra,./.volumes,./.db-upgrade -W=./.db-upgrade --allow-run=docker,podman ./infra/scripts/db-upgrade-18.ts", // once per server: moves the data from Postgres 16 to 18, see docs/postgres-18-upgrade.md
    "proxy:network": "deno run -R=./infra --allow-run=docker,podman ./infra/scripts/proxy-network.ts", // creates the shared "proxy" network when it is missing
    "proxy:start": "deno task proxy:network && docker compose -f ./infra/compose/compose.proxy.yml --env-file ./infra/envs/.env up -d", // keep in step with PROXY_UP in infra/scripts/proxy-network.ts
    "proxy:stop": "docker compose -f ./infra/compose/compose.proxy.yml --env-file ./infra/envs/.env down",
    "deploy": "deno run -R=./infra --allow-run=git,rsync,ssh ./infra/scripts/deploy.ts",
    "env:encrypt": "deno run --no-prompt -R -W=. @spy4x/server/env-age64/cli encrypt",
    "env:decrypt": "deno run --no-prompt -R -W=. @spy4x/server/env-age64/cli decrypt",
    "env:status": "deno run --no-prompt -R -W=. @spy4x/server/env-age64/cli status",
    "env:keygen": "deno run --no-prompt -R -W=. @spy4x/server/env-age64/cli keygen",
    // #endregion Scripts

    // #region Checks
    "check": {
      "command": "echo 'Checks passed!'",
      "description": "Run all checks",
      "dependencies": [
        "lint:check",
        "fmt:check",
        "ts:check",
        "test"
      ]
    },
    "fmt:fix": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint:fix": "deno lint --fix",
    "lint:check": "deno lint",
    "ts:check": "deno run --allow-read --allow-run=deno infra/scripts/type-check.ts",
    // tests/spacing.test.ts, tests/ui-boundary.test.ts, tests/no-direct-date-format.test.ts, tests/api-error-shape.test.ts, tests/dockerfile-base.test.ts, tests/dockerignore.test.ts, tests/compose-migrate.test.ts, tests/offline-removal.test.ts and tests/spa-runtime-config.test.ts read files, so each runs on its own with its own read grant.
    // apps/mpa runs on its own because Fresh reads its build id from DENO_DEPLOYMENT_ID, GITHUB_SHA or CI_COMMIT_SHA when it loads.
    // tests/no-uuid-v4.test.ts reads every text file of the repository (docs/ids.md), so it reads from the root.
    // tests/dockerfiles.test.ts looks for Dockerfiles in every directory, so it reads from the root too.
    // i18n/i18n.test.ts reads the catalogs, and the apps' and libraries' sources for the keys they name.
    // infra/scripts is excluded from the other tools; the "test" block below lets its tests run.
    // libs/ui's interaction tests load happy-dom, whose WebSocket package reads the two WS_* variables.
    "test": "deno test --no-prompt --allow-env=WS_NO_BUFFER_UTIL,WS_NO_UTF_8_VALIDATE apps/api apps/spa/src apps/admin/src apps/worker libs e2e/fixtures && deno test --no-prompt --allow-env=DENO_DEPLOYMENT_ID,GITHUB_SHA,CI_COMMIT_SHA apps/mpa && deno test --no-prompt --allow-read=apps,libs tests/spacing.test.ts && deno test --no-prompt --allow-read=apps,libs/ui tests/ui-boundary.test.ts && deno test --no-prompt --allow-read=apps,libs/ui tests/no-direct-date-format.test.ts && deno test --no-prompt --allow-read=apps/api tests/api-error-shape.test.ts tests/api-spa-switch.test.ts && deno test --no-prompt --allow-read=deno.jsonc,Dockerfile.base tests/dockerfile-base.test.ts && deno test --no-prompt --allow-read=.dockerignore,.gitignore,infra/deploy/include.txt tests/dockerignore.test.ts tests/gitignore.test.ts && deno test --no-prompt --allow-read=infra/compose,apps/worker/+main.ts tests/compose-migrate.test.ts tests/compose-mpa.test.ts tests/compose-api-env.test.ts tests/compose-exposure.test.ts tests/compose-admin.test.ts && deno test --no-prompt --allow-read=infra/compose,infra/postgres,infra/envs/.env.example,infra/scripts/e2e-local.sh,.woodpecker/ci.yml,docs/handoff.md,docs/woodpecker-ci-setup.md tests/compose-postgres.test.ts && deno test --no-prompt --allow-read=infra/compose,infra/configs,infra/backup --allow-run=sh tests/compose-monitoring.test.ts tests/monitoring-alerts.test.ts && deno test --no-prompt --allow-read=libs/server/db/migrations tests/migration-names.test.ts && deno test --no-prompt --allow-read=infra/envs,infra/compose/compose.shared.yml,deno.jsonc,tests --allow-write=tests infra/scripts && deno test --no-prompt --allow-read --allow-write --allow-env --allow-run=deno tests/db-reset-main.test.ts && deno test --no-prompt --allow-read=apps/spa,docs/offline.md tests/offline-removal.test.ts && deno test --no-prompt --allow-read=apps/spa tests/realtime-removal.test.ts tests/spa-reads.test.ts && deno test --no-prompt --allow-read=apps/spa,tests --allow-write=tests --allow-run=sh tests/spa-runtime-config.test.ts && deno test --no-prompt --allow-read=.woodpecker/ci.yml,e2e,docs/development.md,docs/woodpecker-ci-setup.md tests/ci-browser-tests.test.ts && deno test --no-prompt --allow-read=. tests/no-uuid-v4.test.ts && deno test --no-prompt --allow-read=. --allow-env --allow-sys tests/playwright-retries.test.ts && deno test --no-prompt --allow-read=. tests/dockerfiles.test.ts && deno test --no-prompt --allow-read=i18n,apps,libs i18n",
    "test:integration": "ENV=test deno test --no-prompt -E -N -R=./libs/server/db/migrations,./libs/server/db/schema.sql tests/integration",
    "e2e": "PLAYWRIGHT_HTML_OUTPUT_DIR=./e2e/report deno run -A --node-modules-dir npm:playwright@1.57.0 test",
    "test:backup": "bash infra/backup/test-local.sh", // backs a database up and restores it, in containers of its own; see the script
    "test:files": "bash tests/files/run.sh", // the file store against a Garage container of its own: upload, confirm, download, delete; see the script
    "e2e:local": "bash infra/scripts/e2e-local.sh", // the same specs against a stack of its own on spare ports; see the script
    "e2e:report": "PLAYWRIGHT_HTML_OUTPUT_DIR=./e2e/report deno run -A --node-modules-dir npm:playwright@1.57.0 show-report",
    "fix": {
      "command": "echo 'Fixes applied!'",
      "description": "Run all fixes",
      "dependencies": [
        "lint:fix",
        "fmt:fix"
      ]
    },
    "fix-n-check": {
      "command": "echo 'Fixes applied and checks passed!'",
      "description": "Run all fixes and checks",
      "dependencies": [
        "fix",
        "check"
      ]
    },
    // #endregion Checks

    // #region Git Hooks
    "hooks:install": "deno run -R=deno.json,deno.jsonc,.git/hooks/ -W=.git/hooks/ jsr:@hongminhee/deno-task-hooks@0.1.2",
    "hooks:pre-commit": "deno task check"
    // #endregion Git Hooks
  },
  "imports": {
    // #region Aliases
    "@api/services/": "./apps/api/services/",
    "@api/cqrs/": "./apps/api/cqrs/",
    "@spa/state/": "./apps/spa/src/state/",
    "@ui/": "./libs/ui/",
    "@domain/api-tokens": "./libs/domain/api-tokens/+lib.ts",
    "@domain/billing": "./libs/domain/billing/+lib.ts",
    "@domain/groups": "./libs/domain/groups/+lib.ts",
    "@domain/identity": "./libs/domain/identity/+lib.ts",
    "@domain/blog": "./libs/domain/blog/+lib.ts",
    "@domain/contact-links": "./libs/domain/contact-links/+lib.ts",
    "@domain/catalog": "./libs/domain/catalog/+lib.ts",
    "@domain/notes": "./libs/domain/notes/+lib.ts",
    "@domain/tags": "./libs/domain/tags/+lib.ts",
    "@domain/notifications": "./libs/domain/notifications/+lib.ts",
    "@domain/subscribers": "./libs/domain/subscribers/+lib.ts",
    "@domain/errors": "./libs/domain/errors/+lib.ts",
    "@server/api-tokens/": "./libs/server/api-tokens/",
    "@server/auth/": "./libs/server/auth/",
    "@server/billing/": "./libs/server/billing/",
    "@server/files/": "./libs/server/files/",
    "@server/groups/": "./libs/server/groups/",
    "@server/jobs/": "./libs/server/jobs/",
    "@server/mail/": "./libs/server/mail/",
    "@server/blog/": "./libs/server/blog/",
    "@server/contact-links/": "./libs/server/contact-links/",
    "@server/catalog/": "./libs/server/catalog/",
    "@server/notes/": "./libs/server/notes/",
    "@server/tags/": "./libs/server/tags/",
    "@server/notifications/": "./libs/server/notifications/",
    "@server/subscribers/": "./libs/server/subscribers/",
    "@server/telegram/": "./libs/server/telegram/",
    "@platform/": "./libs/platform/",
    "@i18n/": "./i18n/",
    // #endregion Aliases

    // #region Dependencies
    // spy4x/ts-libs 1.95.0 (cron schedules, passkeys, idempotency, keyset cursor, lockout, offline
    // outbox, e-mail proof, the redirect-path check of sign-in's `next`, the password check without
    // a session, billing, the provider's name and picture, the healthcheck's HTTP mode, a key
    // giving up its address, safe Markdown and reading time, copying an object inside the S3
    // store, an error's reason and per-field codes, contact channels, HEIC by its bytes, image
    // processing, translator-aware formats).
    // hono, postgres and arktype below must stay on the exact versions these packages were
    // published with, or two copies load and their types stop matching.
    "@spy4x/validation": "jsr:@spy4x/validation@1.95.0",
    "@spy4x/platform": "jsr:@spy4x/platform@1.95.0",
    "@spy4x/server": "jsr:@spy4x/server@1.95.0",
    "@spy4x/realtime": "jsr:@spy4x/realtime@1.95.0",
    "@spy4x/integrations": "jsr:@spy4x/integrations@1.95.0",
    "@spy4x/email": "jsr:@spy4x/email@1.95.0",
    "@spy4x/net": "jsr:@spy4x/net@1.95.0",
    "@spy4x/billing": "jsr:@spy4x/billing@1.95.0",
    "@spy4x/time": "jsr:@spy4x/time@1.95.0",

    // apps/api
    "hono": "jsr:@hono/hono@4.13.8",
    "@hectorm/otpauth": "jsr:@hectorm/otpauth@9.5.2",
    "qrcode": "jsr:@libs/qrcode@3.1.0",

    // apps/tgbot

    // client
    // spy4x/preact-components 10.12.0. Every package is published at one version together, so all
    // six move in one change, and so does the npm copy of `@spy4x/preact-system` further down
    // (the Playwright config imports it under that name). They take preact and the signals
    // packages as caret ranges, so the versions below are the one copy that loads. wouter-preact
    // must stay on the version they pin, or two copies load.
    "@spy4x/preact-charts": "jsr:@spy4x/preact-charts@10.12.0",
    "@spy4x/preact-icons": "jsr:@spy4x/preact-icons@10.12.0",
    "@spy4x/preact-signals": "jsr:@spy4x/preact-signals@10.12.0",
    "@spy4x/preact-system": "jsr:@spy4x/preact-system@10.12.0",
    "@spy4x/preact-theme": "jsr:@spy4x/preact-theme@10.12.0",
    "@spy4x/preact-ui": "jsr:@spy4x/preact-ui@10.12.0",
    "preact": "npm:preact@10.29.8",
    "wouter-preact": "npm:wouter-preact@3.9.0",
    "@preact/signals": "npm:@preact/signals@2.5.1",
    "@preact/signals-core": "npm:@preact/signals-core@1.12.1",

    // shared
    "@std/async": "jsr:@std/async@1.5.1",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/http": "jsr:@std/http@1.1.4",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/expect": "jsr:@std/expect@1.0.17",
    "@std/testing": "jsr:@std/testing@1.0.16",
    // docs/screenshots/admin-video.ts renders the video's cards; the same version as apps/spa and
    // libs/ui.
    "preact-render-to-string": "npm:preact-render-to-string@6.7.0",
    "@std/encoding": "jsr:@std/encoding@1.0.11",
    "@std/jsonc": "jsr:@std/jsonc@1.0.3",
    "@std/yaml": "jsr:@std/yaml@1.3.0",
    "@playwright/test": "npm:@playwright/test@1.57.0",
    "playwright": "npm:playwright@1.57.0",
    // The website's browser tests check each page with axe-core (e2e/mpa).
    "@axe-core/playwright": "npm:@axe-core/playwright@4.13.0",
    // The npm name of `@spy4x/preact-system` above, for Playwright's loader; it moves with the six.
    "@jsr/spy4x__preact-system": "npm:@jsr/spy4x__preact-system@10.12.0",
    // The npm name of `@spy4x/platform` above, for the same reason: every e2e spec takes `uuidV7`
    // from it. It moves with the `@spy4x/*` packages.
    "@jsr/spy4x__platform": "npm:@jsr/spy4x__platform@1.95.0",

    // shared/types — 2.2.3 matches spy4x/ts-libs and spy4x/preact-components
    // (spy4x/preact-components#121)
    "arktype": "npm:arktype@2.2.3",

    // server/kv
    "@iuioiua/redis": "jsr:@iuioiua/redis@1.1.10",

    // server/db
    "postgres": "npm:postgres@3.4.7",

    // server/jobs: the person's data export is a ZIP (#229); no shared library writes one.
    "fflate": "npm:fflate@0.8.2"
    // #endregion Dependencies
  },
  "exclude": [
    "**/.cache/*",
    "**/dist/*",
    ".volumes",
    ".git",
    "node_modules",
    "dist",
    "build",
    "docs",
    "infra",
    "media/demo",
    "*.lock"
  ],
  // Everything under infra stays out of fmt, lint and type checks; only infra/scripts' tests run.
  "test": {
    "exclude": ["!infra/scripts"]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve",
    "semiColons": false
  },

  // #region Preact Configs
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
  // #endregion Preact Configs
}
