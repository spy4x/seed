{
  "workspace": [
    "./apps/api",
    "./apps/spa",
    "./apps/admin",
    "./apps/mpa",
    "./apps/worker",
    "./libs/platform",
    "./libs/domain/api-tokens",
    "./libs/domain/billing",
    "./libs/domain/groups",
    "./libs/domain/identity",
    "./libs/domain/blog",
    "./libs/domain/contact-links",
    "./libs/domain/catalog",
    "./libs/domain/notes",
    "./libs/domain/tags",
    "./libs/domain/notifications",
    "./libs/domain/subscribers",
    "./libs/domain/errors",
    "./libs/server/api-tokens",
    "./libs/server/auth",
    "./libs/server/billing",
    "./libs/server/files",
    "./libs/server/groups",
    "./libs/server/jobs",
    "./libs/server/mail",
    "./libs/server/blog",
    "./libs/server/contact-links",
    "./libs/server/catalog",
    "./libs/server/notes",
    "./libs/server/tags",
    "./libs/server/notifications",
    "./libs/server/subscribers",
    "./libs/server/telegram",
    "./libs/ui"
  ],
  "nodeModulesDir": "auto",
  "allowScripts": ["npm:@tailwindcss/oxide@4.1.12"],
  "minimumDependencyAge": { "age": "1440", "exclude": ["jsr:@spy4x/*", "npm:@jsr/spy4x__*"] },
  "tasks": {
    "init": {
      "command": "deno run -R=. -W=infra/envs/.env,infra/envs/.env.tmp,infra/configs/vapid.json,infra/configs/vapid.json.tmp,.seed --allow-run=docker,podman,git ./infra/scripts/init.ts",
      "description": "Once after cloning: checks Docker, writes the env file with generated secrets and the web push keys"
    },
    "dev": {
      "command": "deno run -R=./infra --allow-run=docker,podman ./infra/scripts/proxy-network.ts --start && deno run compose up -d",
      "description": "Starts Traefik unless one runs, then the whole development stack"
    },
    "build": {
      "command": "deno task spa:build",
      "description": "Builds the SPA for production"
    },

    // #region apps/api
    "api:dev": {
      "command": "deno run --allow-all --watch apps/api/+main.ts",
      "description": "Starts the API and reloads it on change; Compose runs it"
    },
    "api:prod": {
      "command": "deno run --allow-all apps/api/+main.ts",
      "description": "Starts the API without reloading"
    },
    // the bundles read the demo's blog posts from dist/server/seed-posts (apps/api/dockerfile.node, apps/api/dockerfile.bun)
    "server:build": {
      "command": "deno bundle --platform deno -o dist/server/api.js apps/api/+main.ts && deno bundle --platform deno -o dist/server/worker.js apps/worker/+main.ts && deno bundle --platform deno -o dist/server/migrate.js infra/scripts/db-migrate.ts && deno bundle --platform deno -o dist/server/healthcheck.js apps/healthcheck.ts && rm -rf dist/server/seed-posts && cp -r libs/server/blog/seed-posts dist/server/seed-posts",
      "description": "Bundles the API, worker, migration and healthcheck into dist/server for Node and Bun"
    },
    "api:node": {
      "command": "deno task server:build && node dist/server/api.js",
      "description": "Runs the API on Node, from the bundle"
    },
    "api:bun": {
      "command": "deno task server:build && bun dist/server/api.js",
      "description": "Runs the API on Bun, from the bundle"
    },
    "worker:node": {
      "command": "deno task server:build && node dist/server/worker.js",
      "description": "Runs the worker on Node, from the bundle"
    },
    "worker:bun": {
      "command": "deno task server:build && bun dist/server/worker.js",
      "description": "Runs the worker on Bun, from the bundle"
    },
    // #endregion apps/api

    // #region apps/spa
    "spa:dev": {
      "command": "deno task --cwd apps/spa dev",
      "description": "Starts the SPA in development mode; Compose runs it"
    },
    "spa:build": {
      "command": "deno task --cwd apps/spa build",
      "description": "Builds the SPA"
    },
    // #endregion apps/spa

    // #region apps/admin
    "admin:dev": {
      "command": "deno task --cwd apps/admin dev",
      "description": "Starts the admin app in development mode; Compose runs it"
    },
    "admin:build": {
      "command": "deno task --cwd apps/admin build",
      "description": "Builds the admin app"
    },
    // #endregion apps/admin

    // #region apps/mpa
    "mpa:dev": {
      "command": "deno task --cwd apps/mpa dev",
      "description": "Starts the public website in development mode"
    },
    "mpa:build": {
      "command": "deno task --cwd apps/mpa build",
      "description": "Builds the public website"
    },
    "mpa:start": {
      "command": "deno task --cwd apps/mpa start",
      "description": "Serves the built public website"
    },
    "mpa:check": {
      "command": "deno task --cwd apps/mpa check",
      "description": "Checks the public website"
    },
    "mpa:node": {
      "command": "deno task mpa:build && node apps/mpa/dist/start.js",
      "description": "Builds the public website and serves it on Node (apps/mpa/start.ts)"
    },
    "mpa:bun": {
      "command": "deno task mpa:build && bun apps/mpa/dist/start.js",
      "description": "Builds the public website and serves it on Bun"
    },
    // runs before every MPA image build
    "changelog": {
      "command": "deno run -R=. -W=apps/mpa/changelog.json -E=CI --allow-run=git apps/mpa/changelog-write.ts",
      "description": "Reads the git history into apps/mpa/changelog.json for /changelog and the docs' dates"
    },
    "lighthouse": {
      "command": "apps/mpa/lighthouse/run.sh",
      "description": "Measures the built website against its Lighthouse budget (apps/mpa/lighthouse/run.sh)"
    },
    // #endregion apps/mpa

    // #region Scripts
    "db:migrate": {
      "command": "deno run -N=$DB_HOST:$DB_PORT -E -R=./libs/server/db/migrations ./infra/scripts/db-migrate.ts",
      "description": "Applies the SQL migrations in libs/server/db/migrations"
    },
    "db:reset": {
      "command": "deno run -N -E -R=./infra/envs --allow-run=deno ./infra/scripts/db-reset.ts",
      "description": "Drops, migrates and seeds a development database (ENV=dev only)"
    },
    "db:seed": {
      "command": "deno run -N=$DB_HOST:$DB_PORT -E -R=./libs/server/blog/seed-posts ./infra/scripts/seed-data.ts",
      "description": "Adds the demo data and the development administrator"
    },
    "subscribers:send": {
      "command": "deno run -N -E -R ./apps/worker/subscribers-send.ts",
      "description": "Queues an issue for a mailing list; run it in the worker container (docs/development.md)"
    },
    "user:role": {
      "command": "deno run -N -E -R ./apps/worker/user-role.ts",
      "description": "Gives a person a role by their address, such as operator (docs/apps.md)"
    },
    "operator:create": {
      "command": "deno run -N -E -R ./apps/worker/operator-create.ts",
      "description": "Creates an administrator with a password typed at a prompt, or makes a person one (docs/operator-access.md)"
    },
    "i18n:stamp": {
      "command": "deno run -R=i18n -W=i18n i18n/stamp.ts",
      "description": "Records which English each translation was made from (i18n/TRANSLATING.md)"
    },
    "blog:cover": {
      "command": "deno run -E=OPENAI_API_KEY -N=api.openai.com -R=libs/server/blog/seed-posts/covers -W=libs/server/blog/seed-posts/covers --allow-run=magick libs/server/blog/seed-posts/covers/blog-cover.ts",
      "description": "Makes a blog post's cover with the OpenAI Images API: <slug> <scene> (libs/server/blog/seed-posts/covers/README.md)"
    },
    "blog:social": {
      "command": "deno run -R=./libs/server/blog/seed-posts ./infra/scripts/blog-social.ts",
      "description": "Prints the LinkedIn, Telegram and X texts of one of Seed's own posts: <slug> (docs/blog.md)"
    },
    "deps:check": {
      "command": "deno outdated -r",
      "description": "Lists outdated dependencies"
    },
    "deps:update": {
      "command": "deno outdated -r -u -i",
      "description": "Updates outdated dependencies, asking for each"
    },
    "update:ubuntu": {
      "command": "sudo apt update && sudo apt full-upgrade -y && sudo apt autoremove -y && sudo apt clean && sudo apt --fix-broken install && sudo do-release-upgrade",
      "description": "Upgrades the packages of an Ubuntu server, with sudo"
    },
    "vapid-key:create": {
      "command": "deno run -W=infra/configs/vapid.json ./infra/scripts/vapid-keys-create.ts",
      "description": "Writes new web push keys to infra/configs/vapid.json"
    },
    "load": {
      "command": "deno run -R=./infra/envs --allow-run=docker,podman ./tests/load/run.ts",
      "description": "Runs the k6 load scenarios against the local stack, and the Postgres numbers (docs/load-tests.md)"
    },
    "load:group": {
      "command": "deno run --no-prompt -R=./infra/envs -N=127.0.0.1 -E ./tests/load/group.ts",
      "description": "Builds, removes or explains the large load-test group of a tier (docs/load-tests.md)"
    },
    "video:admin": {
      "command": "deno run -A docs/screenshots/admin-video.ts",
      "description": "Records the website's admin panel video from a local stack"
    },
    "demo-video": {
      "command": "deno run -A media/demo/recipe/record.ts",
      "description": "Records the README's demo video into media/demo; --encode re-encodes the last take (media/demo/recipe/README.md)"
    },
    // reads .volumes to refuse starting Postgres 18 beside unmoved Postgres 16 data; binds the host ports the project publishes, for a moment, to refuse a start when one is taken
    "compose": {
      "command": "deno run -R=./infra,./.volumes --allow-run=docker,podman --allow-net=127.0.0.1,0.0.0.0 ./infra/scripts/compose.ts",
      "description": "Runs Compose for the project; refuses a start when a host port it needs is taken"
    },
    "db:upgrade-18": {
      "command": "deno run -R=./infra,./.volumes,./.db-upgrade -W=./.db-upgrade --allow-run=docker,podman ./infra/scripts/db-upgrade-18.ts",
      "description": "Once per server: moves the data from Postgres 16 to 18 (docs/postgres-18-upgrade.md)"
    },
    "proxy:network": {
      "command": "deno run -R=./infra --allow-run=docker,podman ./infra/scripts/proxy-network.ts",
      "description": "Creates the shared proxy network when it is missing"
    },
    // keep in step with PROXY_UP in infra/scripts/proxy-network.ts
    "proxy:start": {
      "command": "deno task proxy:network && docker compose -f ./infra/compose/compose.proxy.yml --env-file ./infra/envs/.env up -d",
      "description": "Starts Traefik on its own"
    },
    "proxy:stop": {
      "command": "docker compose -f ./infra/compose/compose.proxy.yml --env-file ./infra/envs/.env down",
      "description": "Stops Traefik"
    },
    // the server builds the MPA image from the files sent, so the changelog is written first
    "deploy": {
      "command": "deno task changelog && deno run -R=./infra --allow-run=git,rsync,ssh ./infra/scripts/deploy.ts",
      "description": "Writes the changelog, then copies the production files to the server and starts them"
    },
    "env:encrypt": {
      "command": "deno run --no-prompt -R -W=. @spy4x/server/env-age64/cli encrypt",
      "description": "Encrypts the env files"
    },
    "env:decrypt": {
      "command": "deno run --no-prompt -R -W=. @spy4x/server/env-age64/cli decrypt",
      "description": "Decrypts the env files"
    },
    "env:status": {
      "command": "deno run --no-prompt -R -W=. @spy4x/server/env-age64/cli status",
      "description": "Lists the env files and whether a key is present"
    },
    "env:keygen": {
      "command": "deno run --no-prompt -R -W=. @spy4x/server/env-age64/cli keygen",
      "description": "Makes a new key for the env files"
    },
    // #endregion Scripts

    // #region Checks
    "check": {
      "command": "echo 'Checks passed!'",
      "description": "Run all checks",
      "dependencies": [
        "lint:check",
        "fmt:check",
        "ts:check",
        "test"
      ]
    },
    "fmt:fix": {
      "command": "deno fmt",
      "description": "Formats every file"
    },
    "fmt:check": {
      "command": "deno fmt --check",
      "description": "Checks the format"
    },
    "lint:fix": {
      "command": "deno lint --fix",
      "description": "Lints and fixes what it can"
    },
    "lint:check": {
      "command": "deno lint",
      "description": "Lints"
    },
    "ts:check": {
      "command": "deno run --allow-read --allow-run=deno infra/scripts/type-check.ts",
      "description": "Type check; prints only errors"
    },
    "test": {
      "command": "deno run --allow-run=deno --allow-env=CI infra/scripts/test.ts",
      "description": "Unit tests in parallel; prints failures and one summary line. Paths run only those files; CI=true or --verbose prints everything"
    },
    "test:integration": {
      "command": "ENV=test deno test --no-prompt -E -N -R=./libs/server/db/migrations,./libs/server/db/schema.sql,./libs/server/blog/seed-posts tests/integration",
      "description": "Integration tests against your Postgres and Valkey"
    },
    "e2e": {
      "command": "PLAYWRIGHT_HTML_OUTPUT_DIR=./e2e/report deno run -A --node-modules-dir npm:playwright@1.57.0 test",
      "description": "Browser tests against the stack `dev` started"
    },
    "test:backup": {
      "command": "bash infra/backup/test-local.sh",
      "description": "Backs a database up and restores it, in containers of its own"
    },
    "test:files": {
      "command": "bash tests/files/run.sh",
      "description": "Tests the file store against a Garage container of its own"
    },
    "e2e:local": {
      "command": "bash infra/scripts/e2e-local.sh",
      "description": "Browser tests against a stack of their own on spare ports"
    },
    "test:runtimes": {
      "command": "bash tests/runtimes/smoke.sh",
      "description": "The API, the worker and the website on Deno, Node and Bun, against a running Postgres and Valkey"
    },
    "e2e:report": {
      "command": "PLAYWRIGHT_HTML_OUTPUT_DIR=./e2e/report deno run -A --node-modules-dir npm:playwright@1.57.0 show-report",
      "description": "Opens the report of the last browser test run"
    },
    "fix": {
      "command": "echo 'Fixes applied!'",
      "description": "Run all fixes",
      "dependencies": [
        "lint:fix",
        "fmt:fix"
      ]
    },
    "fix-n-check": {
      "command": "echo 'Fixes applied and checks passed!'",
      "description": "Run all fixes and checks",
      "dependencies": [
        "fix",
        "check"
      ]
    },
    // #endregion Checks

    // #region Git Hooks
    "hooks:install": {
      "command": "deno run -R=deno.json,deno.jsonc,.git/hooks/ -W=.git/hooks/ jsr:@hongminhee/deno-task-hooks@0.1.2",
      "description": "Installs a git hook that runs check before every commit"
    },
    "hooks:pre-commit": {
      "command": "deno task check",
      "description": "What the pre-commit hook runs"
    }
    // #endregion Git Hooks
  },
  "imports": {
    // #region Aliases
    "@api/services/": "./apps/api/services/",
    "@api/cqrs/": "./apps/api/cqrs/",
    "@spa/state/": "./apps/spa/src/state/",
    "@ui/": "./libs/ui/",
    "@domain/api-tokens": "./libs/domain/api-tokens/+lib.ts",
    "@domain/billing": "./libs/domain/billing/+lib.ts",
    "@domain/groups": "./libs/domain/groups/+lib.ts",
    "@domain/identity": "./libs/domain/identity/+lib.ts",
    "@domain/blog": "./libs/domain/blog/+lib.ts",
    "@domain/contact-links": "./libs/domain/contact-links/+lib.ts",
    "@domain/catalog": "./libs/domain/catalog/+lib.ts",
    "@domain/notes": "./libs/domain/notes/+lib.ts",
    "@domain/tags": "./libs/domain/tags/+lib.ts",
    "@domain/notifications": "./libs/domain/notifications/+lib.ts",
    "@domain/subscribers": "./libs/domain/subscribers/+lib.ts",
    "@domain/errors": "./libs/domain/errors/+lib.ts",
    "@server/api-tokens/": "./libs/server/api-tokens/",
    "@server/auth/": "./libs/server/auth/",
    "@server/billing/": "./libs/server/billing/",
    "@server/files/": "./libs/server/files/",
    "@server/groups/": "./libs/server/groups/",
    "@server/jobs/": "./libs/server/jobs/",
    "@server/mail/": "./libs/server/mail/",
    "@server/blog/": "./libs/server/blog/",
    "@server/contact-links/": "./libs/server/contact-links/",
    "@server/catalog/": "./libs/server/catalog/",
    "@server/notes/": "./libs/server/notes/",
    "@server/tags/": "./libs/server/tags/",
    "@server/notifications/": "./libs/server/notifications/",
    "@server/subscribers/": "./libs/server/subscribers/",
    "@server/telegram/": "./libs/server/telegram/",
    "@platform/": "./libs/platform/",
    "@i18n/": "./i18n/",
    // #endregion Aliases

    // #region Dependencies
    // spy4x/ts-libs 1.114.0 (cron schedules, passkeys, idempotency, keyset cursor, lockout, offline
    // outbox, e-mail proof, the redirect-path check of sign-in's `next`, the password check without
    // a session, billing, the provider's name and picture, the healthcheck's HTTP mode, a key
    // giving up its address, safe Markdown and reading time, copying an object inside the S3
    // store, an error's reason and per-field codes, contact channels, HEIC by its bytes, image
    // processing, translator-aware formats, the changes pull of a group, process adapters for Node
    // and Bun, signals, the port-only healthcheck, and the default environment, `runCommand` and
    // file storage on Node and Bun, serving HTTP and WebSockets, Redis and DNS on Node and Bun, a
    // billing period per plan price).
    // hono, postgres and arktype below must stay on the exact versions these packages were
    // published with, or two copies load and their types stop matching.
    "@spy4x/validation": "jsr:@spy4x/validation@1.116.0",
    "@spy4x/platform": "jsr:@spy4x/platform@1.116.0",
    "@spy4x/server": "jsr:@spy4x/server@1.116.0",
    "@spy4x/realtime": "jsr:@spy4x/realtime@1.116.0",
    "@spy4x/integrations": "jsr:@spy4x/integrations@1.116.0",
    "@spy4x/email": "jsr:@spy4x/email@1.116.0",
    "@spy4x/net": "jsr:@spy4x/net@1.116.0",
    "@spy4x/billing": "jsr:@spy4x/billing@1.116.0",
    "@spy4x/time": "jsr:@spy4x/time@1.116.0",

    // apps/api
    "hono": "jsr:@hono/hono@4.13.8",
    "@hectorm/otpauth": "jsr:@hectorm/otpauth@9.5.2",
    "qrcode": "jsr:@libs/qrcode@3.1.0",

    // apps/tgbot

    // client
    // spy4x/preact-components 13.11.1. Every package is published at one version together, so all
    // seven move in one change, and so does the npm copy of `@spy4x/preact-system` further down
    // (the Playwright config imports it under that name). They take preact and the signals
    // packages as caret ranges, so the versions below are the one copy that loads. wouter-preact
    // must stay on the version they pin, or two copies load.
    "@spy4x/preact-charts": "jsr:@spy4x/preact-charts@13.11.1",
    "@spy4x/preact-icons": "jsr:@spy4x/preact-icons@13.11.1",
    "@spy4x/preact-server": "jsr:@spy4x/preact-server@13.11.1",
    "@spy4x/preact-signals": "jsr:@spy4x/preact-signals@13.11.1",
    "@spy4x/preact-system": "jsr:@spy4x/preact-system@13.11.1",
    "@spy4x/preact-theme": "jsr:@spy4x/preact-theme@13.11.1",
    "@spy4x/preact-ui": "jsr:@spy4x/preact-ui@13.11.1",
    "preact": "npm:preact@10.29.8",
    "wouter-preact": "npm:wouter-preact@3.9.0",
    "@preact/signals": "npm:@preact/signals@2.5.1",
    "@preact/signals-core": "npm:@preact/signals-core@1.12.1",

    // shared
    "@std/async": "jsr:@std/async@1.5.1",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/expect": "jsr:@std/expect@1.0.17",
    "@std/testing": "jsr:@std/testing@1.0.16",
    // docs/screenshots/admin-video.ts renders the video's cards; the same version as apps/spa and
    // libs/ui.
    "preact-render-to-string": "npm:preact-render-to-string@6.7.0",
    "@std/encoding": "jsr:@std/encoding@1.0.11",
    "@std/jsonc": "jsr:@std/jsonc@1.0.3",
    "@std/yaml": "jsr:@std/yaml@1.3.0",
    // Seed's own blog posts are Markdown files with YAML front matter (libs/server/blog/seed-posts).
    "@std/front-matter": "jsr:@std/front-matter@1.0.9",
    "@playwright/test": "npm:@playwright/test@1.57.0",
    "playwright": "npm:playwright@1.57.0",
    // The website's browser tests check each page with axe-core (e2e/mpa).
    "@axe-core/playwright": "npm:@axe-core/playwright@4.13.0",
    // The npm name of `@spy4x/preact-system` above, for Playwright's loader; it moves with the seven.
    "@jsr/spy4x__preact-system": "npm:@jsr/spy4x__preact-system@13.11.1",
    // The npm name of `@spy4x/platform` above, for the same reason: every e2e spec takes `uuidV7`
    // from it. It moves with the `@spy4x/*` packages.
    "@jsr/spy4x__platform": "npm:@jsr/spy4x__platform@1.116.0",

    // shared/types — 2.2.3 matches spy4x/ts-libs and spy4x/preact-components
    // (spy4x/preact-components#121)
    "arktype": "npm:arktype@2.2.3",

    // server/kv
    "@iuioiua/redis": "jsr:@iuioiua/redis@1.1.10",

    // server/db
    "postgres": "npm:postgres@3.4.7",

    // server/jobs: the person's data export is a ZIP (#229); no shared library writes one.
    "fflate": "npm:fflate@0.8.2"
    // #endregion Dependencies
  },
  "exclude": [
    "**/.cache/*",
    "**/dist/*",
    ".volumes",
    ".git",
    "node_modules",
    "dist",
    "build",
    "docs",
    "infra",
    "media/demo",
    "*.lock"
  ],
  // Everything under infra stays out of fmt, lint and type checks; only infra/scripts' tests run.
  "test": {
    "exclude": ["!infra/scripts"]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve",
    "semiColons": false
  },

  // #region Preact Configs
  "compilerOptions": {
