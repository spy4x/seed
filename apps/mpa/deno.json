{
  "tasks": {
    "build": "deno run -A --node-modules-dir=auto npm:vite@7.3.6 build",
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "deno run -A --node-modules-dir=auto npm:vite@7.3.6",
    // Needs the MPA and the API at MPA_BASE_URL (default http://app.localhost), /api going to the API.
    "e2e": "deno run -A --node-modules-dir npm:playwright@1.57.0 test --config=../../e2e/mpa/playwright.config.ts",
    // Needs the dev stack, cwebp, magick and tar: screenshots/README.md.
    "screenshots": "deno run -A screenshots/capture.ts",
    "start": "deno serve -A _fresh/server.js"
  },
  "imports": {
    "@/": "./",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@1.1.2",
    "@spy4x/platform/universal/is-record": "jsr:@spy4x/platform@1.92.0/universal/is-record",
    "@spy4x/platform/universal/seo": "jsr:@spy4x/platform@1.92.0/universal/seo",
    "@spy4x/server/http/bounded-body": "jsr:@spy4x/server@1.92.0/http/bounded-body",
    "@spy4x/server/http/same-origin": "jsr:@spy4x/server@1.92.0/http/same-origin",
    "@spy4x/server/http/security-headers": "jsr:@spy4x/server@1.92.0/http/security-headers",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.1.12",
    "@types/babel__core": "npm:@types/babel__core@7.20.5",
    "fresh": "jsr:@fresh/core@2.3.3",
    "preact": "npm:preact@10.29.8",
    "tailwindcss": "npm:tailwindcss@4.1.12",
    "vite": "npm:vite@7.3.6"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  },
  "lint": {
    "rules": {
      "tags": ["fresh", "recommended"]
    }
  },
  "exclude": ["**/_fresh/*"]
}
