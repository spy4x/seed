ARG DENO_VERSION=2.9.7
# The release pipeline starts from the published base image instead (BASE_IMAGE).
ARG BASE_IMAGE=localhost/app/deno-base:${DENO_VERSION}
FROM ${BASE_IMAGE}

# Copy application code with proper ownership
USER root
COPY --chown=1000:1000 . .
USER 1000:1000

# Migrations run in compose's one-shot `migrate` service, which the API waits for.
CMD ["sh", "-c", "if [ \"$ENV\" = \"prod\" ]; then deno task api:prod; else deno task api:dev; fi"]
