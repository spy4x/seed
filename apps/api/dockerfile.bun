# The API, the worker and the migration on Bun, for a product that sets APP_RUNTIME=bun: the
# Bun counterpart of apps/api/dockerfile (infra/compose/compose.runtime-bun.yml, docs/apps.md).
#
# Deno bundles the four entry points at build time (`deno task server:build`, into dist/server),
# and the final image holds Bun, the bundles, the migrations and the `vips` command line the worker
# processes images with. npm packages are inside the bundles; the image installs none.
# Self-contained, so CI builds it with no base image from a registry. Images pinned by digest.

FROM docker.io/denoland/deno:alpine-2.9.7@sha256:8ce780168429c4bf5962652e6cbea3fd45254ae902069e90585fb33f74c56968 AS build
WORKDIR /app
COPY . .
# --frozen fails the build when deno.lock does not match deno.jsonc.
RUN deno install --frozen && deno task server:build

FROM docker.io/oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a
# `vips-tools` (libvips 8.15 or newer), `vips-heif` to read HEIC and `libheif-aom` to write AVIF,
# as in Dockerfile.base (docs/files.md).
RUN apk add --no-cache vips-tools vips-heif libheif-aom
WORKDIR /app
COPY --from=build --chown=1000:1000 /app/dist/server ./dist/server
# The migration reads them from here (infra/scripts/db-migrate.ts), as on Deno.
COPY --from=build --chown=1000:1000 /app/libs/server/db/migrations ./libs/server/db/migrations
USER 1000:1000

# The release pipeline names the tag and the commit it builds from; the operator area's System page
# shows them. A local build leaves both empty.
ARG APP_VERSION=
ARG APP_COMMIT=
ENV APP_VERSION=${APP_VERSION} APP_COMMIT=${APP_COMMIT}

# The worker and the migration run this image with another command (compose.runtime-bun.yml).
CMD ["bun", "dist/server/api.js"]
