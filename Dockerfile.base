# Base Dockerfile for app
# This image contains the common setup for all Deno-based services
# Build: docker build -t app/deno-base:${DENO_VERSION} -f Dockerfile.base --build-arg DENO_VERSION=X.X.X

ARG DENO_VERSION=2.9.7
FROM denoland/deno:alpine-${DENO_VERSION}

WORKDIR /app

# Install common system dependencies
RUN apk add --no-cache git curl bash libstdc++ libgcc

# Copy dependency manifests for better layer caching. Every workspace member of deno.jsonc needs a
# line here, or older Deno versions fail `deno install` (tests/dockerfile-base.test.ts checks it).
COPY deno.jsonc deno.lock ./
COPY apps/api/deno.json ./apps/api/deno.json
COPY apps/mpa/deno.json ./apps/mpa/deno.json
COPY apps/spa/deno.json ./apps/spa/deno.json
COPY apps/worker/deno.json ./apps/worker/deno.json
COPY libs/domain/api-tokens/deno.json ./libs/domain/api-tokens/deno.json
COPY libs/domain/billing/deno.json ./libs/domain/billing/deno.json
COPY libs/domain/groups/deno.json ./libs/domain/groups/deno.json
COPY libs/domain/identity/deno.json ./libs/domain/identity/deno.json
COPY libs/domain/notes/deno.json ./libs/domain/notes/deno.json
COPY libs/domain/tags/deno.json ./libs/domain/tags/deno.json
COPY libs/domain/notifications/deno.json ./libs/domain/notifications/deno.json
COPY libs/domain/subscribers/deno.json ./libs/domain/subscribers/deno.json
COPY libs/server/api-tokens/deno.json ./libs/server/api-tokens/deno.json
COPY libs/server/auth/deno.json ./libs/server/auth/deno.json
COPY libs/server/billing/deno.json ./libs/server/billing/deno.json
COPY libs/server/groups/deno.json ./libs/server/groups/deno.json
COPY libs/server/jobs/deno.json ./libs/server/jobs/deno.json
COPY libs/server/mail/deno.json ./libs/server/mail/deno.json
COPY libs/server/notes/deno.json ./libs/server/notes/deno.json
COPY libs/server/tags/deno.json ./libs/server/tags/deno.json
COPY libs/server/notifications/deno.json ./libs/server/notifications/deno.json
COPY libs/server/subscribers/deno.json ./libs/server/subscribers/deno.json
COPY libs/platform/deno.json ./libs/platform/deno.json
COPY libs/ui/deno.json ./libs/ui/deno.json

# Install dependencies (this layer will be cached if deno.jsonc doesn't change)
RUN deno install

# Set ownership for non-root user and ensure deno cache is writable
RUN chown -R 1000:1000 /app /deno-dir
USER 1000:1000
